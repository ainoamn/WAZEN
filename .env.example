# Preferred: Neon Postgres (production).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Optional alias
# NEON_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Legacy optional: Turso/libSQL (only if Neon is not used).
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=replace-with-a-scoped-token

# Comma-separated owners who may receive super_admin on account creation / first SSO.
WAZEN_ADMIN_EMAILS=a.hamid89@hotmail.com
WAZEN_APP_ORIGIN=https://your-domain.example

# BHD unified identity (SSO). Defaults to the live issuer; first-party PKCE does not need a client secret.
BHD_IDENTITY_ISSUER=https://id.bhd-om.com
# Optional. Token/authorize host while id.bhd-om.com times out from some networks. Defaults to https://one-bhd.vercel.app when the issuer is the canonical domain.
# BHD_IDENTITY_ENDPOINT=https://one-bhd.vercel.app
BHD_OAUTH_CLIENT_ID=bhd-wazen
# Optional. Same value as BHD_OAUTH_CLIENT_SECRET_WAZEN on one-bhd when using confidential token auth.
# BHD_OAUTH_CLIENT_SECRET=
# Leave unset so the callback matches the host the user is on (wazen.bhd-om.com or wazen-roan.vercel.app).
# BHD_OAUTH_REDIRECT_URI=
# Interim HS256 (until identity publishes RS256 JWKS). Same value as IDENTITY_TOKEN_SECRET on one-bhd.
# BHD_IDENTITY_TOKEN_SECRET=
# Set to 1 only to force the local email form.
# BHD_OAUTH_DISABLED=

# Optional Google sign-in (Identity Services, same as Hisaby). Client ID is public.
# JavaScript origin: https://your-domain.example
GOOGLE_CLIENT_ID=162957418455-d734efb8n4oe0ba5e664583a255ks50t.apps.googleusercontent.com
# Optional. Only needed for the legacy redirect flow, not the login button.
# GOOGLE_CLIENT_SECRET=

# Optional Sentry DSN for error ingest (also accepts WAZEN_SENTRY_DSN).
# SENTRY_DSN=https://publicKey@o0.ingest.sentry.io/0

# Soft RLS is on by default (app.bypass_rls=1). Set to 1 only after wiring app.user_id per request.
# WAZEN_RLS_ENFORCE=0
# Mark Staging readiness before flipping enforce (shown in launch readiness checklist).
# WAZEN_RLS_DRY_RUN=1
# After counsel signs privacy/terms, set to 1 so readiness checklist turns green.
# WAZEN_LEGAL_COUNSEL_SIGNED=0

# Optional Web Push (VAPID). Public key is exposed to the browser; private stays server-only.
# WAZEN_VAPID_PUBLIC_KEY=
# WAZEN_VAPID_PRIVATE_KEY=
# WAZEN_VAPID_SUBJECT=mailto:support@your-domain.example
# Drain push_outbox: POST /api/jobs/push with Authorization: Bearer $WAZEN_JOB_SECRET

# Optional Thawani Pay (card checkout). Without these, pricing stays on manual bank transfer.
# WAZEN_CHECKOUT_PROVIDER=auto
# WAZEN_THAWANI_SECRET_KEY=
# WAZEN_THAWANI_PUBLISHABLE_KEY=
# WAZEN_THAWANI_API_BASE=https://checkout.thawani.om/api/v1
# WAZEN_THAWANI_WEBHOOK_SECRET=
# WAZEN_PAYMENT_PROVIDER_HOSTS=checkout.thawani.om,uatcheckout.thawani.om
# Set to 1 only for UAT when the provider cannot sign webhooks.
# WAZEN_THAWANI_ALLOW_UNSIGNED=0

# Optional OmanNet (or bank middleware). POST JSON to CHECKOUT_URL; webhook at /api/webhooks/payment/omannet
# WAZEN_OMANNET_API_KEY=
# WAZEN_OMANNET_CHECKOUT_URL=https://payments.example/omannet/session
# WAZEN_OMANNET_WEBHOOK_SECRET=
# WAZEN_OMANNET_ALLOW_UNSIGNED=0

# Vercel Cron uses CRON_SECRET automatically for /api/jobs/tick (also accepts WAZEN_JOB_SECRET).
# CRON_SECRET=

# Generate at least 32 random bytes for provider webhook verification.
WAZEN_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
WAZEN_JOB_SECRET=replace-with-another-long-random-secret

# Preferred: send via Resend (https://resend.com). Domain must be Verified.
RESEND_API_KEY=re_xxxxxxxx
# Example after verifying bhd-om.com: Wazen <noreply@bhd-om.com>
RESEND_FROM_EMAIL="Wazen <noreply@bhd-om.com>"

# Legacy optional: custom HTTPS webhook bridge (ignored when RESEND_* is set).
# WAZEN_EMAIL_WEBHOOK_URL=https://email-provider.example/send-template
# WAZEN_EMAIL_WEBHOOK_TOKEN=replace-with-provider-token
# WAZEN_EMAIL_PROVIDER_HOSTS=email-provider.example
WAZEN_PAYMENT_PROVIDER_HOSTS=api.payment-provider.example

# --- WhatsApp Cloud API (Meta) — invites when member has a phone ---
# Create an app at developers.facebook.com → WhatsApp → get token + phone number id.
# WHATSAPP_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# Approved template name (required for cold invites outside the 24h window):
# WHATSAPP_INVITE_TEMPLATE=wazen_invite
# WHATSAPP_TEMPLATE_LANG=ar

# --- SMS (pick ONE) ---
# Twilio: https://www.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+968xxxxxxxx
# Unifonic (MENA): https://www.unifonic.com
# UNIFONIC_APP_SID=xxxxxxxx
# UNIFONIC_SENDER_ID=Wazen
# UNIFONIC_BASE_URL=https://el.cloud.unifonic.com

# JSON keyring: active key ID plus 32-byte base64 keys. Retain old keys while rotating encrypted rows.
WAZEN_ENCRYPTION_KEYRING={"active":"v1","keys":{"v1":"replace-with-32-byte-base64-key"}}

# Local-only switches. Keep both disabled in Vercel Production.
WAZEN_DEMO_MODE=0
WAZEN_USE_NODE_SQLITE=0
WAZEN_TRUST_OAI_HEADERS=0
