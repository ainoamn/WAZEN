# Required on Vercel: persistent Turso/libSQL database (never use /tmp SQLite).
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-scoped-token

# Comma-separated owners who may receive super_admin on account creation.
WAZEN_ADMIN_EMAILS=owner@example.com
WAZEN_APP_ORIGIN=https://your-domain.example

# Generate at least 32 random bytes for provider webhook verification.
WAZEN_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
WAZEN_JOB_SECRET=replace-with-another-long-random-secret
WAZEN_EMAIL_WEBHOOK_URL=https://email-provider.example/send-template
WAZEN_EMAIL_WEBHOOK_TOKEN=replace-with-provider-token
WAZEN_EMAIL_PROVIDER_HOSTS=email-provider.example
WAZEN_PAYMENT_PROVIDER_HOSTS=api.payment-provider.example

# JSON keyring: active key ID plus 32-byte base64 keys. Retain old keys while rotating encrypted rows.
WAZEN_ENCRYPTION_KEYRING={"active":"v1","keys":{"v1":"replace-with-32-byte-base64-key"}}

# Local-only switches. Keep both disabled in Vercel Production.
WAZEN_DEMO_MODE=0
WAZEN_USE_NODE_SQLITE=0
WAZEN_TRUST_OAI_HEADERS=0
